{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string" },
        "tag": { "type": "string" },
        "containerPort": { "type": "integer", "default": 8080 }
      },
      "required": ["repository", "pullPolicy", "containerPort"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" }
      },
      "required": ["type", "port"]
    },
    "rbac": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "clusterWide": { "type": "boolean", "default": true }
      }
    }
  }
}
